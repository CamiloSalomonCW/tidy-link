{
  "manifest_version": 3,
  "name": "TidyLink — GitHub & Jira Shortcuts",
  "version": "1.1.0",
  "description": "Copy GitHub PR titles and Jira ticket keys and titles as clickable formatted links.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{87717126-51e5-48a5-9d79-4637c9a1d410}",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["activeTab", "clipboardWrite", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "TidyLink settings",
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
